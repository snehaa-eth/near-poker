{
  "name": "dark-table",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier . --write --cache",
    "test": "pnpm --filter @nli/poker-engine build && pnpm --filter @nli/poker-engine test && pnpm --filter server test",
    "test:poker": "pnpm --filter @nli/poker-engine test",
    "demo": "pnpm --filter @nli/poker-engine build && pnpm --filter server demo",
    "test:contract": "cd contract && npm install && npm run build && npm test"
  },
  "devDependencies": {
    "config": "workspace:*",
    "prettier": "^3.2.5",
    "turbo": "^2"
  },
  "packageManager": "pnpm@8.9.0",
  "engines": {
    "node": ">=18"
  }
}

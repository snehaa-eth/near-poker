{
  "name": "@nli/poker-pool",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./markets": "./src/markets.ts",
    "./witnesses": "./src/witnesses.ts"
  },
  "scripts": {
    "compact": "compact compile src/nli-treasury.compact src/managed/treasury",
    "compact:fast": "compact compile --skip-zk src/nli-treasury.compact src/managed/treasury",
    "build": "pnpm run compact:fast",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "typescript": "^5.6.2"
  }
}
